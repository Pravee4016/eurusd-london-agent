# Environment configuration for EUR/USD London Session Trading Agent

# Finnhub API
FINNHUB_API_KEY=your_finnhub_key

# Groq AI API
GROQ_API_KEY=your_groq_key

# Telegram (separate bot for EUR/USD)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Google Cloud Platform (new project for EUR/USD)
GOOGLE_CLOUD_PROJECT=eurusd_gcp_trading
CLOUD_FUNCTION_REGION=us-central1
FIRESTORE_DATABASE=eurusd-trading

# Trading Configuration
TIME_ZONE=Europe/London
MARKET_OPEN_TIME=08:00
MARKET_CLOSE_TIME=16:00
ANALYSIS_START_TIME=07:55

# Debug mode (True for development, False for production)
DEBUG_MODE=False
DEPLOYMENT_MODE=LOCAL

# Optional: Override defaults
# MIN_SIGNAL_CONFIDENCE=65
# MAX_ALERTS_PER_DAY=999
# MAX_ALERTS_PER_TYPE=10
# MAX_ALERTS_PER_INSTRUMENT=15
